# Git attributes for InfoMAE

# Auto detect text files and perform LF normalization
* text=auto

# Python files
*.py text eol=lf diff=python

# Shell scripts
*.sh text eol=lf
*.bash text eol=lf

# Markdown files
*.md text eol=lf
*.markdown text eol=lf

# YAML files
*.yml text eol=lf
*.yaml text eol=lf

# JSON files
*.json text eol=lf

# Configuration files
*.toml text eol=lf
*.cfg text eol=lf
*.ini text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Documentation
*.txt text eol=lf
*.rst text eol=lf
LICENSE text eol=lf
README text eol=lf

# Binary files
*.pkl binary
*.pth binary
*.pt binary
*.h5 binary
*.hdf5 binary
*.npy binary
*.npz binary

# Images
*.jpg binary
*.jpeg binary
*.png binary
*.gif binary
*.ico binary
*.svg text eol=lf

# Archives
*.zip binary
*.tar binary
*.gz binary
*.bz2 binary

# Model weights - use Git LFS
*.pth filter=lfs diff=lfs merge=lfs -text
*.pt filter=lfs diff=lfs merge=lfs -text
*.ckpt filter=lfs diff=lfs merge=lfs -text

# Large data files - use Git LFS
*.h5 filter=lfs diff=lfs merge=lfs -text
*.hdf5 filter=lfs diff=lfs merge=lfs -text

